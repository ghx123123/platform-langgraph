APP_ENV=development
HOST=127.0.0.1
PORT=8000
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
DATABASE_PATH=./backend/data/platform.db
CHECKPOINT_PATH=./backend/data/checkpoints.db
MODEL_SETTINGS_PATH=./backend/data/model_settings.json

# Use "mock" for a fully local deterministic run, or "openai_compatible" for a real model.
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=90

VITE_API_BASE_URL=/api
VITE_WS_BASE_URL=
